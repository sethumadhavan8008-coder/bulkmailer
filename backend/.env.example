PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Google Cloud OAuth 2.0 Web application credentials
GOOGLE_CLIENT_ID=replace-with-your-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-client-secret

# Must match the callback URI configured in Google Cloud Console
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Use your MongoDB Atlas connection string. Needed for session storage.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER/YOUR_DB?retryWrites=true&w=majority

# Generate a long random value, e.g. with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# Optional: maximum recipients per single request. Gmail quotas still apply.
MAX_RECIPIENTS_PER_REQUEST=25
